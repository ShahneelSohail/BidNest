generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ItemStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  email           String           @unique
  passwordHash    String
  fullName        String
  role            Role             @default(USER)
  isBlocked       Boolean          @default(false)
  avatarUrl       String?
  location        String?
  bio             String?
  isPublic        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  items           Item[]           @relation("Seller")
  addresses       Address[]
  orders          Order[]
  preferences     NotificationPreference[]
  autoBids        AutoBid[]
  bids            Bid[]
  watchlist       Watchlist[]
  notifications   Notification[]
  ratingsGiven    Rating[]         @relation("Rater")
  ratingsReceived Rating[]         @relation("Rated")
  messages        ContactMessage[] @relation("MessageAuthor")
  repliedMessages ContactMessage[] @relation("MessageReplier")
  messageReplies  MessageReply[]   @relation("ReplyAuthor")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  isActive Boolean    @default(true)
  sortOrder Int       @default(0)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  items    Item[]
}

model Item {
  id              Int            @id @default(autoincrement())
  sellerId        Int
  title           String
  description     String?
  categoryId      Int?
  minBid          Decimal        @db.Decimal(12, 2)
  bidIncrement    Decimal        @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime
  status          ItemStatus     @default(PENDING)
  featured        Boolean        @default(false)
  rejectionReason String?
  adminNotes      String?
  currentPrice    Decimal        @db.Decimal(12, 2)
  currentBidId    Int?           @unique
  paidAt          DateTime?
  condition       String?
  reviewedAt      DateTime?
  viewCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  order           Order?
  seller          User           @relation("Seller", fields: [sellerId], references: [id])
  category        Category?      @relation(fields: [categoryId], references: [id])
  currentBid      Bid?           @relation("CurrentBid", fields: [currentBidId], references: [id])
  bids            Bid[]          @relation("ItemBids")
  images          ItemImage[]
  documents       ItemDocument[]
  watchers        Watchlist[]
  ratings         Rating[]
  autoBids        AutoBid[]

  @@index([status, endDate])
  @@index([sellerId])
  @@index([categoryId])
}

model ItemImage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ItemDocument {
  id        Int      @id @default(autoincrement())
  itemId    Int
  fileName  String
  url       String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Bid {
  id        Int      @id @default(autoincrement())
  itemId    Int
  bidderId  Int
  amount    Decimal  @db.Decimal(12, 2)
  bidTime   DateTime @default(now())
  isWinning Boolean  @default(false)
  item      Item     @relation("ItemBids", fields: [itemId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id])
  heldBy    Item?    @relation("CurrentBid")

  @@index([itemId, amount(sort: Desc)])
  @@index([bidderId])
}

model Watchlist {
  id      Int      @id @default(autoincrement())
  userId  Int
  itemId  Int
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Rating {
  id          Int      @id @default(autoincrement())
  raterId     Int
  ratedUserId Int
  itemId      Int
  score       Int
  comment     String?
  createdAt   DateTime @default(now())
  rater       User     @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User     @relation("Rated", fields: [ratedUserId], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([raterId, itemId])
}

model ContactMessage {
  id                     Int           @id @default(autoincrement())
  userId                 Int?
  name                   String
  email                  String
  subject                String
  message                String
  newsletterSubscription Boolean       @default(false)
  status                 MessageStatus @default(NEW)
  adminReply             String?
  repliedAt              DateTime?
  repliedByUserId        Int?
  readAt                 DateTime?
  createdAt              DateTime      @default(now())
  user                   User?         @relation("MessageAuthor", fields: [userId], references: [id], onDelete: SetNull)
  repliedBy              User?         @relation("MessageReplier", fields: [repliedByUserId], references: [id])
  replies                MessageReply[]

  @@index([status])
}

model MessageReply {
  id        Int            @id @default(autoincrement())
  messageId Int
  authorId  Int?
  fromAdmin Boolean
  body      String
  createdAt DateTime       @default(now())
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author    User?          @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  name      String
  line1     String
  line2     String?
  city      String
  region    String
  postal    String
  country   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id             Int      @id @default(autoincrement())
  itemId         Int      @unique
  buyerId        Int
  receiptNo      String   @unique
  shippingTo     Json
  deliveryMethod String
  itemPrice      Decimal  @db.Decimal(12, 2)
  shippingCost   Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  paymentLabel   String
  stripeSessionId String? @unique
  paidAt         DateTime @default(now())
  item           Item     @relation(fields: [itemId], references: [id])
  buyer          User     @relation(fields: [buyerId], references: [id])
}

model NotificationPreference {
  id      Int     @id @default(autoincrement())
  userId  Int
  event   String
  channel String
  enabled Boolean
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, channel])
}

model AutoBid {
  id        Int      @id @default(autoincrement())
  itemId    Int
  userId    Int
  maxAmount Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}
