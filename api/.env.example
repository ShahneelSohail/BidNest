NODE_ENV=development
PORT=4000

# PostgreSQL. `npm run db:dev` starts a local database on this URL, or use docker compose.
DATABASE_URL=postgresql://bidnest:bidnest@localhost:5432/bidnest

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Public URL of this API, used to build links to uploaded images
PUBLIC_API_URL=http://localhost:4000

# Web app URL, used for the Stripe return links
WEB_URL=http://localhost:3000

# Optional card payments with Stripe (test mode keys start with sk_test_). Leave empty to use the demo checkout.
# For local webhooks run: stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
